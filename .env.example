# Polymarket auto-trading bot — environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env file, and NEVER paste your private key anywhere else.

# --- Wallet ---
# Private key of the EOA wallet used to sign orders (0x-prefixed hex string).
# Required only for LIVE trading. Leave empty for paper trading.
POLY_PRIVATE_KEY=

# Polygon mainnet chain id.
POLY_CHAIN_ID=137

# Polymarket CLOB REST API host.
POLY_CLOB_HOST=https://clob.polymarket.com

# Signature type: 0 = plain EOA wallet (MetaMask/hardware wallet),
# 1 = email/Magic wallet, 2 = Polymarket.com browser proxy wallet.
# If you deposited/trade through the polymarket.com UI, this is almost always 2,
# and POLY_FUNDER_ADDRESS below must be your Polymarket proxy wallet address
# (shown on your profile page), NOT your EOA address.
POLY_SIGNATURE_TYPE=0

# Address that actually holds your USDC funds on Polymarket.
POLY_FUNDER_ADDRESS=

# --- Safety switch ---
# Set to "true" only when you are ready to place REAL orders with REAL funds.
# Defaults to paper trading (fully simulated, no orders sent, no funds at risk).
LIVE_TRADING=false

# --- Misc ---
# Path to the strategy/risk config file.
BOT_CONFIG_PATH=config/settings.yaml

# ============================================================
# gmgn.ai smart-money screener (independent of the bot above)
# ============================================================

# Path to the screener's threshold config file.
GMGN_CONFIG_PATH=config/gmgn_settings.yaml

# Chain to screen (sol / eth / base / bsc). Overrides the YAML "chain" key.
GMGN_CHAIN=sol

# How often to run a scan cycle, in seconds. Overrides the YAML key.
GMGN_POLL_INTERVAL_SECONDS=60

# gmgn.ai has no official public API — these let you adjust to a
# Cloudflare block (HTTP 403) without editing code:
#   GMGN_API_BASE_URL   override the API host (rarely needed)
#   GMGN_USER_AGENT      a current, real browser User-Agent string
#   GMGN_COOKIE           a cf_clearance/session cookie captured from a
#                          logged-out gmgn.ai browser tab's dev tools,
#                          if plain requests keep getting 403'd
GMGN_API_BASE_URL=
GMGN_USER_AGENT=
GMGN_COOKIE=

# Optional alert channels — leave blank to only log to console/logs/gmgn.log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
