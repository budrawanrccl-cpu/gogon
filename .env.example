# Polymarket auto-trading bot — environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env file, and NEVER paste your private key anywhere else.

# --- Wallet ---
# Private key of the EOA wallet used to sign orders (0x-prefixed hex string).
# Required only for LIVE trading. Leave empty for paper trading.
POLY_PRIVATE_KEY=

# Polygon mainnet chain id.
POLY_CHAIN_ID=137

# Polymarket CLOB REST API host.
POLY_CLOB_HOST=https://clob.polymarket.com

# Signature type: 0 = plain EOA wallet (MetaMask/hardware wallet),
# 1 = email/Magic wallet, 2 = Polymarket.com browser proxy wallet.
# If you deposited/trade through the polymarket.com UI, this is almost always 2,
# and POLY_FUNDER_ADDRESS below must be your Polymarket proxy wallet address
# (shown on your profile page), NOT your EOA address.
POLY_SIGNATURE_TYPE=0

# Address that actually holds your USDC funds on Polymarket.
POLY_FUNDER_ADDRESS=

# --- Safety switch ---
# Set to "true" only when you are ready to place REAL orders with REAL funds.
# Defaults to paper trading (fully simulated, no orders sent, no funds at risk).
LIVE_TRADING=false

# --- Misc ---
# Path to the strategy/risk config file.
BOT_CONFIG_PATH=config/settings.yaml


# =============================================================================
# pump.fun momentum bot (Solana) — see pumpbot/ and the README section on it.
# Separate process from the Polymarket bot above; run with `python -m pumpbot.main`.
# =============================================================================

# --- Wallet ---
# Base58-encoded Solana secret key (the format Phantom/Solflare export), or a
# JSON int array (the format `solana-keygen` writes). Required only for LIVE
# trading. Leave empty for paper trading. Signing happens locally in this
# process — this key is never sent to PumpPortal or any RPC.
# NEVER commit your real .env file, and NEVER paste your private key anywhere else.
SOLANA_PRIVATE_KEY=

# Your own Solana RPC endpoint. The free public endpoint below works for
# testing but is rate-limited and unreliable for live trading — get a paid
# RPC (Helius, QuickNode, Triton, etc.) before setting LIVE_TRADING=true.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public wallet address (safe to set — this is NOT a secret) used by
# scripts/pumpbot_dashboard.py to display your live SOL balance. If left
# blank, the dashboard tries to derive it from SOLANA_PRIVATE_KEY instead
# (only possible once that's set); if neither is set, the balance panel
# just shows "not configured".
SOLANA_WALLET_ADDRESS=

# PumpPortal (third-party, unofficial pump.fun API) endpoints.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_TRADE_API=https://pumpportal.fun/api/trade-local
# Optional API key — only needed if PumpPortal requires one for your usage
# tier (e.g. subscribing to many tokens' trade events). Leave blank otherwise.
PUMPPORTAL_API_KEY=

# --- Safety switch ---
# Shared with the Polymarket bot above: set to "true" only when you are
# ready to send REAL transactions with REAL SOL. Defaults to paper trading
# (fully simulated, nothing broadcast, no funds at risk).
# LIVE_TRADING=false

# Path to the pump.fun bot's strategy/risk config file.
PUMPBOT_CONFIG_PATH=config/pumpbot_settings.yaml
