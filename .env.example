# Polymarket auto-trading bot — environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env file, and NEVER paste your private key anywhere else.

# --- Wallet ---
# Private key of the EOA wallet used to sign orders (0x-prefixed hex string).
# Required only for LIVE trading. Leave empty for paper trading.
POLY_PRIVATE_KEY=

# Polygon mainnet chain id.
POLY_CHAIN_ID=137

# Polymarket CLOB REST API host.
POLY_CLOB_HOST=https://clob.polymarket.com

# Signature type: 0 = plain EOA wallet (MetaMask/hardware wallet),
# 1 = email/Magic wallet, 2 = Polymarket.com browser proxy wallet.
# If you deposited/trade through the polymarket.com UI, this is almost always 2,
# and POLY_FUNDER_ADDRESS below must be your Polymarket proxy wallet address
# (shown on your profile page), NOT your EOA address.
POLY_SIGNATURE_TYPE=0

# Address that actually holds your USDC funds on Polymarket.
POLY_FUNDER_ADDRESS=

# --- Safety switch ---
# Set to "true" only when you are ready to place REAL orders with REAL funds.
# Defaults to paper trading (fully simulated, no orders sent, no funds at risk).
LIVE_TRADING=false

# --- Misc ---
# Path to the strategy/risk config file.
BOT_CONFIG_PATH=config/settings.yaml

# =============================================================================
# pump.fun wallet copy-trading bot (separate bot, `python -m pumpfun_bot.main`)
# =============================================================================

# Base58-encoded Solana private key (Phantom/Solflare "export private key"
# format), or a JSON array of 64 ints (a Solana CLI keypair file's contents,
# pasted as a single-line string). Required only for LIVE copy-trading.
# Leave empty for paper trading. NEVER commit this or paste it anywhere else.
SOLANA_PRIVATE_KEY=

# Solana RPC endpoint. Public RPCs are rate-limited and unreliable for
# anything beyond light testing — a private RPC (Helius, QuickNode, Triton,
# etc.) is strongly recommended before going live.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Set to "true" only when you are ready to copy trades with REAL SOL.
# Defaults to paper trading (fully simulated, no transactions sent, no
# wallet required).
PF_LIVE_TRADING=false

# Path to the pump.fun bot's watch-list/sizing/risk config file.
PF_CONFIG_PATH=config/pumpfun_settings.yaml
